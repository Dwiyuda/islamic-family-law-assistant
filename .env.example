# Copy to .env (git-ignored) and fill in. Never commit or print real keys.
# groq | gemini | none (none = retrieval-only, no LLM)
LLM_PROVIDER=none
# Model id from the provider's /models list
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
# Seconds between LLM calls (free-tier rate limits)
LLM_MIN_INTERVAL=2.5
# Evaluation judge model; empty = LLM_MODEL
JUDGE_MODEL=
IFLA_DEVICE=cpu
HF_HUB_OFFLINE=1
